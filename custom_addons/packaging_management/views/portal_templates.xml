<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="portal_spec_approval_page" name="Packaging Specification Approval">
        <t t-call="portal.portal_layout">
            <t t-set="title" t-value="spec.name + ' - Design Approval'"/>
            <div class="container py-4">

                <!-- Alert Berhasil Approval -->
                <t t-if="approved_just_now">
                    <div class="alert alert-success alert-dismissible fade show shadow-sm mb-4" role="alert">
                        <h4 class="alert-heading mb-1"><i class="fa fa-check-circle me-2"/>Persetujuan Berhasil Disimpan!</h4>
                        <p class="mb-0">Terima kasih. Spesifikasi kemasan dan desain cetak <strong><t t-esc="spec.name"/></strong> telah disetujui untuk proses produksi massal pabrik.</p>
                    </div>
                </t>

                <!-- Header Informasi -->
                <div class="card shadow-sm mb-4 border-0 bg-light">
                    <div class="card-body p-4 d-flex flex-wrap justify-content-between align-items-center">
                        <div>
                            <span class="badge bg-secondary text-uppercase px-3 py-2 mb-2">Customer Approval Portal</span>
                            <h2 class="h3 fw-bold mb-1 text-primary"><t t-esc="spec.name"/></h2>
                            <p class="text-muted mb-0"><i class="fa fa-building me-1"/> <t t-esc="spec.partner_id.name"/></p>
                        </div>
                        <div class="mt-3 mt-md-0 text-md-end">
                            <span class="text-muted d-block small mb-1">Status Spesifikasi</span>
                            <t t-if="spec.state == 'approved'">
                                <span class="badge bg-success fs-6 px-3 py-2"><i class="fa fa-check me-1"/> Approved / Siap Produksi</span>
                            </t>
                            <t t-elif="spec.state == 'sample'">
                                <span class="badge bg-warning text-dark fs-6 px-3 py-2"><i class="fa fa-hourglass-half me-1"/> Menunggu Persetujuan Mockup</span>
                            </t>
                            <t t-else="">
                                <span class="badge bg-info text-dark fs-6 px-3 py-2"><t t-esc="spec.state.title()"/></span>
                            </t>
                        </div>
                    </div>
                </div>

                <div class="row g-4">
                    <!-- Kolom Kiri: Visual Mockup / Desain Kemasan -->
                    <div class="col-lg-7">
                        <div class="card shadow-sm h-100 border-0">
                            <div class="card-header bg-white py-3 border-bottom">
                                <h5 class="card-title mb-0 fw-bold"><i class="fa fa-image text-primary me-2"/>Desain Mockup &amp; Artwork</h5>
                            </div>
                            <div class="card-body p-4 text-center">
                                <t t-if="spec.artwork_image">
                                    <div class="position-relative border rounded p-2 bg-white shadow-sm mb-3">
                                        <img t-att-src="'/web/image/packaging.specification/%s/artwork_image' % spec.id"
                                             class="img-fluid rounded"
                                             style="max-height: 480px; width: auto; object-fit: contain;"
                                             alt="Mockup Desain Kemasan"/>
                                    </div>
                                </t>
                                <t t-else="">
                                    <div class="border rounded p-5 bg-light text-muted mb-3">
                                        <i class="fa fa-cube fa-4x mb-3 text-secondary"/>
                                        <p class="mb-0 fw-semibold">Mockup desain 3D sedang dalam proses render oleh tim R&amp;D pabrik.</p>
                                    </div>
                                </t>

                                <t t-if="spec.artwork_file">
                                    <div class="d-grid mt-3">
                                        <a t-att-href="'/web/content/packaging.specification/%s/artwork_file/%s?download=true' % (spec.id, spec.artwork_filename or 'pisau_pond.pdf')"
                                           class="btn btn-outline-primary">
                                            <i class="fa fa-download me-2"/>Unduh Gambar Kerja Pisau Pond (PDF / CAD)
                                        </a>
                                    </div>
                                </t>
                            </div>
                        </div>
                    </div>

                    <!-- Kolom Kanan: Rincian Teknis & Form Approval Digital -->
                    <div class="col-lg-5">
                        <!-- Rincian Dimensi & Material -->
                        <div class="card shadow-sm mb-4 border-0">
                            <div class="card-header bg-white py-3 border-bottom">
                                <h5 class="card-title mb-0 fw-bold"><i class="fa fa-list-alt text-primary me-2"/>Spesifikasi Teknis Box</h5>
                            </div>
                            <div class="card-body p-3">
                                <table class="table table-sm table-borderless mb-0">
                                    <tbody>
                                        <tr>
                                            <td class="text-muted">Ukuran Box (P x L x T)</td>
                                            <td class="fw-bold text-end">
                                                <t t-esc="'%g x %g x %g mm' % (spec.length, spec.width, spec.height)"/>
                                            </td>
                                        </tr>
                                        <tr>
                                            <td class="text-muted">Tipe Box &amp; Sambungan</td>
                                            <td class="fw-bold text-end"><t t-esc="spec.box_type.upper()"/> (<t t-esc="spec.joint_type.title()"/>)</td>
                                        </tr>
                                        <tr>
                                            <td class="text-muted">Gelombang (Flute)</td>
                                            <td class="fw-bold text-end"><t t-esc="spec.flute_type.upper()"/>-Flute</td>
                                        </tr>
                                        <tr>
                                            <td class="text-muted">Substansi Kertas</td>
                                            <td class="fw-bold text-end"><t t-esc="spec.paper_substance"/></td>
                                        </tr>
                                        <tr>
                                            <td class="text-muted">Warna Cetak Flexo</td>
                                            <td class="fw-bold text-end">
                                                <t t-if="spec.printing_colors > 0">
                                                    <span class="badge bg-primary"><t t-esc="spec.printing_colors"/> Warna</span>
                                                </t>
                                                <t t-else="">
                                                    <span class="badge bg-secondary">Polos</span>
                                                </t>
                                            </td>
                                        </tr>
                                        <tr>
                                            <td class="text-muted">Luas Lembaran Mentah</td>
                                            <td class="fw-bold text-end"><t t-esc="'%.4f m²' % spec.sheet_area_sqm"/></td>
                                        </tr>
                                        <tr>
                                            <td class="text-muted">Toleransi Kirim Pabrik</td>
                                            <td class="fw-bold text-end">±<t t-esc="spec.delivery_tolerance_pct"/>%</td>
                                        </tr>
                                    </tbody>
                                </table>
                            </div>
                        </div>

                        <!-- Card Approval / Tanda Tangan Digital -->
                        <div class="card shadow-sm border-0">
                            <div class="card-header bg-white py-3 border-bottom">
                                <h5 class="card-title mb-0 fw-bold"><i class="fa fa-pencil-square-o text-primary me-2"/>Persetujuan Pelanggan</h5>
                            </div>
                            <div class="card-body p-4">
                                <t t-if="spec.state == 'approved' and spec.approval_signature">
                                    <div class="text-center py-2">
                                        <div class="badge bg-success px-3 py-2 mb-3"><i class="fa fa-check-circle me-1"/> Desain Telah Disetujui</div>
                                        <div class="border rounded p-3 bg-light mb-3">
                                            <img t-att-src="'data:image/png;base64,%s' % spec.approval_signature.decode('utf-8')"
                                                 class="img-fluid"
                                                 style="max-height: 120px;"
                                                 alt="Digital Signature"/>
                                        </div>
                                        <p class="mb-1 fw-bold"><t t-esc="spec.signed_by"/></p>
                                        <p class="small text-muted mb-0">Disetujui pada: <t t-esc="spec.signed_on"/></p>
                                    </div>
                                </t>
                                <t t-else="">
                                    <form t-att-action="'/my/packaging/%s/approve' % spec.id" method="post" id="approval_form">
                                        <input type="hidden" name="token" t-att-value="token"/>
                                        <input type="hidden" name="signature" id="signature_input"/>

                                        <div class="mb-3">
                                            <label class="form-label fw-semibold" for="signee_name">Nama Penandatangan / PIC Pelanggan</label>
                                            <input type="text" class="form-control" id="signee_name" name="signee_name"
                                                   t-att-value="spec.partner_id.name" required="required"
                                                   placeholder="Contoh: Bpk. Budi Santoso (Quality Control)"/>
                                        </div>

                                        <div class="mb-3">
                                            <div class="d-flex justify-content-between align-items-center mb-1">
                                                <label class="form-label fw-semibold mb-0">Goreskan Tanda Tangan Digital</label>
                                                <button type="button" class="btn btn-link btn-sm text-decoration-none text-danger p-0" id="clear_sig_btn">
                                                    <i class="fa fa-eraser me-1"/>Hapus
                                                </button>
                                            </div>
                                            <div class="border rounded bg-white" style="touch-action: none;">
                                                <canvas id="signature_pad" width="400" height="150" style="width: 100%; height: 150px; cursor: crosshair;"></canvas>
                                            </div>
                                            <small class="text-muted d-block mt-1">Gunakan mouse atau jari di layar sentuh untuk tanda tangan.</small>
                                        </div>

                                        <div class="d-grid mt-4">
                                            <button type="submit" class="btn btn-success btn-lg shadow-sm" id="submit_sig_btn">
                                                <i class="fa fa-check me-2"/>Setujui Desain &amp; Cetak Massal
                                            </button>
                                        </div>
                                    </form>

                                    <!-- Script Canvas Signature Pad -->
                                    <script type="text/javascript">
                                        document.addEventListener('DOMContentLoaded', function() {
                                            var canvas = document.getElementById('signature_pad');
                                            if (!canvas) return;

                                            var ctx = canvas.getContext('2d');
                                            var isDrawing = false;
                                            var hasDrawn = false;

                                            // Setup high-dpi canvas
                                            var rect = canvas.getBoundingClientRect();
                                            canvas.width = rect.width * 2;
                                            canvas.height = rect.height * 2;
                                            ctx.scale(2, 2);
                                            ctx.strokeStyle = '#1e3a8a';
                                            ctx.lineWidth = 2.5;
                                            ctx.lineCap = 'round';
                                            ctx.lineJoin = 'round';

                                            function getPos(e) {
                                                var cRect = canvas.getBoundingClientRect();
                                                var clientX = e.clientX || (e.touches &amp;&amp; e.touches[0].clientX);
                                                var clientY = e.clientY || (e.touches &amp;&amp; e.touches[0].clientY);
                                                return {
                                                    x: clientX - cRect.left,
                                                    y: clientY - cRect.top
                                                };
                                            }

                                            function startDraw(e) {
                                                isDrawing = true;
                                                hasDrawn = true;
                                                var pos = getPos(e);
                                                ctx.beginPath();
                                                ctx.moveTo(pos.x, pos.y);
                                                e.preventDefault();
                                            }

                                            function draw(e) {
                                                if (!isDrawing) return;
                                                var pos = getPos(e);
                                                ctx.lineTo(pos.x, pos.y);
                                                ctx.stroke();
                                                e.preventDefault();
                                            }

                                            function endDraw() {
                                                isDrawing = false;
                                            }

                                            canvas.addEventListener('mousedown', startDraw);
                                            canvas.addEventListener('mousemove', draw);
                                            window.addEventListener('mouseup', endDraw);

                                            canvas.addEventListener('touchstart', startDraw, { passive: false });
                                            canvas.addEventListener('touchmove', draw, { passive: false });
                                            window.addEventListener('touchend', endDraw);

                                            document.getElementById('clear_sig_btn').addEventListener('click', function() {
                                                ctx.clearRect(0, 0, canvas.width, canvas.height);
                                                hasDrawn = false;
                                            });

                                            document.getElementById('approval_form').addEventListener('submit', function(e) {
                                                if (!hasDrawn) {
                                                    alert('Silakan bubuhkan tanda tangan digital Anda terlebih dahulu pada kotak tanda tangan.');
                                                    e.preventDefault();
                                                    return false;
                                                }
                                                var dataUrl = canvas.toDataURL('image/png');
                                                document.getElementById('signature_input').value = dataUrl;
                                            });
                                        });
                                    </script>
                                </t>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </t>
    </template>
</odoo>
