<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Inherit stock.picking form view untuk menampilkan toleransi pengiriman -->
    <record id="view_picking_form_inherit_packaging_tolerance" model="ir.ui.view">
        <field name="name">stock.picking.form.inherit.packaging.tolerance</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='move_ids']/list//field[@name='quantity']" position="after">
                <field name="delivery_tolerance_pct" string="Tol (±%)" optional="show"/>
                <field name="min_delivery_qty" string="Min (Tol)" optional="hide"/>
                <field name="max_delivery_qty" string="Max (Tol)" optional="show"/>
                <field name="tolerance_status" widget="badge"
                       decoration-success="tolerance_status == 'within'"
                       decoration-danger="tolerance_status == 'over'"
                       decoration-warning="tolerance_status == 'under'"
                       optional="show"/>
            </xpath>
        </field>
    </record>
</odoo>
